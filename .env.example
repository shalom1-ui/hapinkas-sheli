# קובץ דוגמה למשתני סביבה. יש להעתיק לקובץ בשם ".env" ולמלא ערכים אמיתיים בעת המעבר לייצור.
# בכל עוד לא מגדירים משתנה מסוים, המערכת פועלת אוטומטית ב"מצב MOCK" (בדיקה) עבורו.

# ---------- כללי ----------
PORT=3000
JWT_SECRET=change-this-to-a-long-random-string-in-production
PUBLIC_BASE_URL=https://your-domain.example.com

# ---------- Twilio (שיחות טלפון: שחזור סיסמה קולי + מנוע ה-IVR) ----------
# להשאיר TWILIO_MOCK=true כל עוד אין חשבון Twilio אמיתי - השיחות רק יודפסו ללוג.
TWILIO_MOCK=true
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token_here
# TWILIO_FROM_NUMBER=+972500000000
RECOVERY_MOCK=true

# ---------- Cardcom (סליקת "תרומה חודשית") ----------
CARDCOM_MOCK=true
# CARDCOM_TERMINAL_NUMBER=1000
# CARDCOM_API_NAME=your_api_name
# CARDCOM_API_PASSWORD=your_api_password

# ---------- מייל (עדכוני התקדמות אוטומטיים להורים) ----------
EMAIL_MOCK=true
# SENDGRID_API_KEY=your_key_here   (או פרטי ספק אחר, לפי הבחירה)
# EMAIL_FROM=no-reply@your-domain.example.com

# ---------- מסד נתונים ----------
# ברירת מחדל: data/app.db (נוצר אוטומטית). אין צורך לשנות אלא אם רוצים מיקום אחר.
# DB_PATH=/var/data/app.db

# ---------- מסמכים שהועלו (טפסים סרוקים וכו') ----------
# ברירת מחדל: data/uploads (נוצר אוטומטית). אין צורך לשנות אלא אם רוצים מיקום אחר (למשל דיסק חיצוני).
# UPLOADS_DIR=/var/data/uploads

# ---------- זיהוי דיבור משודרג (ימות המשיח + OpenAI Whisper) ----------
# להשאיר WHISPER_MOCK=true כל עוד לא מוגדרים שני המפתחות למטה - המערכת תמשיך להשתמש בזיהוי הדיבור
# הרגיל של ימות (כמו היום), בלי שום שינוי בהתנהגות. ר' README, סעיף "זיהוי דיבור משודרג" להסבר מלא
# ולהוראות איך משיגים כל מפתח.
WHISPER_MOCK=true
# מפתח API קבוע של ימות המשיח (לא סיסמת ההתחברות הרגילה!) - מושג בפאנל הניהול של ימות, תחת
# "הגדרות פיירוול" (או "הגדרות מתקדמות" -> "API"), יצירת "מפתח API" חדש.
# YEMOT_API_TOKEN=0501234567:xxxxxxxxxx
# מספר השלוחה שלכם בימות (אותו מספר שכבר מצאתם קודם עבור פנייה לתמיכה) - נדרש כדי לדעת איפה לשמור
# ולחפש הקלטות זמניות.
# YEMOT_EXTENSION_NUMBER=1
# מפתח API של OpenAI (לתמלול קולי באמצעות Whisper) - נוצר בכתובת https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
